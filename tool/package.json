{
  "name": "pickup-arrow-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:geometry": "node --test tests/arrow-geometry.test.mjs",
    "test:regions": "node --test tests/region-edge.test.mjs tests/region-move.test.mjs",
    "test:camera": "node --test tests/board-camera.test.mjs",
    "test:metrics": "node --test tests/board-metrics.test.mjs",
    "test:settings": "node --test tests/editor-settings.test.mjs",
    "test:library": "node --test tests/library.test.mjs",
    "test:core": "node --test tests/core-host.test.mjs tests/editor-core.test.mjs",
    "test:notice": "node --test tests/editor-notice.test.mjs",
    "test:smoke-runner": "node --test tests/smoke-selection.test.mjs",
    "smoke": "npm run build && electron . --smoke-test",
    "smoke:preferences": "npm run build && electron . --smoke-test=preferences",
    "smoke:workflow": "npm run build && electron . --smoke-test=workflow",
    "smoke:layout": "npm run build && electron . --smoke-test=layout",
    "smoke:placement": "npm run build && electron . --smoke-test=placement",
    "smoke:editing": "npm run build && electron . --smoke-test=editing",
    "smoke:all": "npm run build && electron . --smoke-test=all",
    "start:local-unsandboxed": "npm run build && electron --no-sandbox ."
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.9.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
